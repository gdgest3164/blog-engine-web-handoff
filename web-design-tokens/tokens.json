{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Blog Engine Design Token 단일 진실 — 임의값 사용 금지. tailwind-plugin.cjs + eslint-rule.cjs 가 강제.",

  "colors": {
    "$comment": "12개 한정. 의미 기반 명명. 임의 hex 금지.",
    "neutral-0": "#ffffff",
    "neutral-50": "#f8fafc",
    "neutral-200": "#e2e8f0",
    "neutral-500": "#64748b",
    "neutral-800": "#1e293b",
    "neutral-1000": "#020617",

    "primary-500": "#2563eb",
    "primary-700": "#1d4ed8",

    "danger-500": "#dc2626",
    "warning-500": "#d97706",
    "success-500": "#16a34a",
    "accent-500": "#7c3aed"
  },

  "spacing": {
    "$comment": "8px 그리드 기반 8단계. 임의 px 금지.",
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px"
  },

  "fontSize": {
    "$comment": "6단계.",
    "xs": ["12px", { "lineHeight": "16px" }],
    "sm": ["14px", { "lineHeight": "20px" }],
    "base": ["16px", { "lineHeight": "24px" }],
    "lg": ["18px", { "lineHeight": "28px" }],
    "xl": ["24px", { "lineHeight": "32px" }],
    "2xl": ["32px", { "lineHeight": "40px" }]
  },

  "shadow": {
    "$comment": "3단계.",
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
  },

  "radius": {
    "$comment": "4단계.",
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "16px"
  },

  "fontFamily": {
    "$comment": "한글 우선.",
    "sans": ["'Pretendard'", "system-ui", "sans-serif"],
    "mono": ["'JetBrains Mono'", "ui-monospace", "monospace"]
  }
}
